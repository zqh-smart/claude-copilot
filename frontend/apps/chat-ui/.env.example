# Public client configuration
# These are read at build time by Vite (must be prefixed with VITE_).
VITE_LANGGRAPH_API_URL=http://127.0.0.1:2025
VITE_LANGGRAPH_ASSISTANT_ID=agent

# Server-only / backend secrets belong in backend/.env or backend/langgraph.env.
# Never add a VITE_ prefix to a LangSmith API key or any backend credential.
LANGSMITH_API_KEY=