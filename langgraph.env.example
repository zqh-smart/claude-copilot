APP_NAME=Claude Copilot
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
LLM_MODEL_NAME=qwen3.5
LLM_MODEL_BASE_URL=http://192.168.0.102:30000/v1
LLM_MODEL_API_KEY=
LLM_MODEL_API_TYPE=openai
LLM_GROUNDED_SYNTHESIS_ENABLED=true
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_REVISIONS=1
SILICON_BASE_URL=https://api.siliconflow.cn/v1
SILICON_KEY=
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BACKEND=silicon
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANK_BACKEND=silicon
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
HYBRID_VECTOR_WEIGHT=0.65
HYBRID_LEXICAL_WEIGHT=0.35
RETRIEVAL_CANDIDATE_MULTIPLIER=4
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/claude_copilot
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=document_segments_bge_m3
VECTOR_STORE_BACKEND=qdrant
GRAPH_STORE_BACKEND=local
STORAGE_BACKEND=postgres
INGESTION_WORKER_COUNT=2
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_DELAY_SECONDS=2
INGESTION_RECOVER_ON_STARTUP=true
INGESTION_INLINE_EXECUTION_ENABLED=true
INGESTION_WORKER_ID=
INGESTION_LEASE_SECONDS=120
INGESTION_HEARTBEAT_SECONDS=30
INGESTION_ALERT_OLDEST_READY_SECONDS=300
INGESTION_ALERT_RETRY_WAIT_COUNT=5
INGESTION_ALERT_RECENT_FAILURE_COUNT=1
INGESTION_ALERT_FAILURE_WINDOW_SECONDS=3600
OBSERVABILITY_CAPTURE_CONTENT=false
DOCUMENT_STORAGE_PATH=./data/documents
RAW_DATA_PATH=./data/raw
PARSED_DATA_PATH=./data/parsed
REPORT_DATA_PATH=./data/reports
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
