APP_NAME=Claude Copilot
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

LLM_MODEL_NAME=qwen3.5
LLM_MODEL_BASE_URL=http://192.168.0.102:30000/v1
LLM_MODEL_API_KEY=
LLM_MODEL_API_TYPE=openai
# Local LLM down/502? Switch chat to Silicon (uses SILICON_KEY + SILICON_BASE_URL):
# LLM_MODEL_API_TYPE=silicon
# LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
LLM_GROUNDED_SYNTHESIS_ENABLED=true
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_REVISIONS=1
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANK_BACKEND=auto
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
HYBRID_VECTOR_WEIGHT=0.65
HYBRID_LEXICAL_WEIGHT=0.35
RETRIEVAL_CANDIDATE_MULTIPLIER=4
SILICON_BASE_URL=https://api.siliconflow.cn/v1
SILICON_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Agent Chat UI → langgraph `agent` graph (optional; else latest serving_eval doc)
# AGENT_CHAT_DOC_ID=

POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/claude_copilot
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=document_segments_bge_m3
VECTOR_STORE_BACKEND=qdrant
GRAPH_STORE_BACKEND=local
GRAPH_DATA_PATH=./data/graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=claude-copilot
NEO4J_DATABASE=neo4j
REDIS_URL=redis://localhost:6379/0
INGESTION_WORKER_COUNT=2
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_DELAY_SECONDS=2
INGESTION_RECOVER_ON_STARTUP=false
INGESTION_INLINE_EXECUTION_ENABLED=false
INGESTION_WORKER_ID=
INGESTION_LEASE_SECONDS=120
INGESTION_HEARTBEAT_SECONDS=30
INGESTION_ALERT_OLDEST_READY_SECONDS=300
INGESTION_ALERT_RETRY_WAIT_COUNT=5
INGESTION_ALERT_RECENT_FAILURE_COUNT=1
INGESTION_ALERT_FAILURE_WINDOW_SECONDS=3600

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claude-copilot

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
OBSERVABILITY_CAPTURE_CONTENT=false

FEATURE_PIPELINE_ENABLED=false
STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/documents
RAW_DATA_PATH=./data/raw
PARSED_DATA_PATH=./data/parsed
REPORT_DATA_PATH=./data/reports
PDF_PARSER_BACKEND_PRIORITY=mineru_pdf,table_pdf,native_pdf,ocr_pdf
MARKDOWN_SPLIT_BY_HEADERS=true
DOCX_EXTRACT_TABLES=true
