APP_NAME=Claude Copilot
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

DEFAULT_LLM_PROVIDER=silicon
DEFAULT_LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
LLM_GROUNDED_SYNTHESIS_ENABLED=true
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_REVISIONS=1
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RERANK_BACKEND=auto
RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
HYBRID_VECTOR_WEIGHT=0.65
HYBRID_LEXICAL_WEIGHT=0.35
RETRIEVAL_CANDIDATE_MULTIPLIER=4
SILICON_BASE_URL=https://api.siliconflow.cn/v1
SILICON_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/claude_copilot
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=document_segments_bge_m3
VECTOR_STORE_BACKEND=qdrant
GRAPH_STORE_BACKEND=local
GRAPH_DATA_PATH=./data/graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=claude-copilot
NEO4J_DATABASE=neo4j
REDIS_URL=redis://localhost:6379/0

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=claude-copilot

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

FEATURE_PIPELINE_ENABLED=false
STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/documents
RAW_DATA_PATH=./data/raw
PARSED_DATA_PATH=./data/parsed
REPORT_DATA_PATH=./data/reports
PDF_PARSER_BACKEND_PRIORITY=mineru_pdf,table_pdf,native_pdf,ocr_pdf
MARKDOWN_SPLIT_BY_HEADERS=true
DOCX_EXTRACT_TABLES=true
